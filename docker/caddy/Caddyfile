{
	email epyur@ya.ru
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

https://{$DOMAIN} {
	encode gzip

	handle /api/ekn/* {
		reverse_proxy ekn:3000
	}

	handle /api/agent/* {
		reverse_proxy agent:3000
	}

	handle /api/contacts/* {
		reverse_proxy contacts:3000
	}

	handle /api/lab/* {
		reverse_proxy lab:3000
	}

	handle /api/documents/* {
		reverse_proxy documents:3000
	}

	handle /api/photo/* {
		reverse_proxy photo:3000
	}

	handle /api/llm/* {
		reverse_proxy llm:3000
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle /auth/* {
		reverse_proxy auth-service:3000
	}

	handle /health {
		reverse_proxy auth-service:3000
	}

	handle /registry.json {
		reverse_proxy auth-service:3000
	}

	# Инструмент ручной загрузки файлов плагина (2026-08-29) — статическая раздача
	# файлов, загруженных через POST /auth/registry/upload (auth-service пишет в
	# ./www/plugins/<dir>/, тот же хост-каталог, что уже смонтирован сюда read-only
	# как часть /srv/www). См. docs/superpowers/specs/2026-08-29-sbe-plugin-file-upload-design.md.
	handle /plugins/* {
		root * /srv/www
		file_server
	}

	# «ЦУП Веб» (2026-09-02) — портал на Vue (web/sbe-web/, отдельный git-репо),
	# статика собранного dist/ лежит в ./www/app/ (тот же смонтированный /srv/www,
	# что и registry.json/plugins/*). try_files — фоллбек на index.html для
	# клиентского роутинга (hash-history не требует его для маршрутизации внутри
	# портала, но защищает прямой заход на /app/ без хвоста). См.
	# docs/superpowers/specs/2026-09-02-sbe-web-portal-design.md.
	handle_path /app/* {
		root * /srv/www/app
		try_files {path} /index.html
		file_server
	}

	handle {
		respond "Mailers stack is up"
	}
}
