# Шаблон переменных окружения стека mailers.
# Реальный файл живёт ТОЛЬКО на сервере: /opt/mailers/.env
# Секреты в вольт не кладём. Актуальные значения: сервер + гайд.md + process.md.

POSTGRES_USER=mailers
POSTGRES_PASSWORD=<secret>
POSTGRES_DB=mailers
DOMAIN=epyur.fvds.ru

AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=<secret>
AUTH_POSTGRES_DB=auth
JWT_SECRET=<secret>
APPS_REGISTER_SECRET=<secret>
SMTP_FROM=noreply@epyur.fvds.ru
MAILER_OWNER_EMAIL=<owner@tn.ru>
MAILER_SERVICE_SECRET=<secret>

# documents-service (плагин «Документы»)
DOCUMENTS_POSTGRES_USER=documents
DOCUMENTS_POSTGRES_PASSWORD=<secret>
DOCUMENTS_POSTGRES_DB=documents
DOCUMENTS_OWNER_EMAIL=<owner@tn.ru>
DOCUMENTS_SERVICE_SECRET=<secret>

# lab-service (плагин «Заявки на испытания»)
LAB_POSTGRES_USER=lab
LAB_POSTGRES_PASSWORD=<secret>
LAB_POSTGRES_DB=lab
LAB_OWNER_EMAIL=<owner@tn.ru>
LAB_SERVICE_SECRET=<secret>
# Мониторинг почты lpitn@yandex.ru (2026-08-24, тестовый режим — точечная
# выгрузка `fetch-mail`, постоянный воркер выключен: LAB_MAIL_ENABLED=false).
# Пароль — НЕ пароль десктопной версии LIMS_LPI; отдельный app-пароль Яндекса.
LAB_MAIL_ENABLED=false
LAB_MAIL_IMAP_SERVER=imap.yandex.ru
LAB_MAIL_LOGIN=lpitn@yandex.ru
LAB_MAIL_PASSWORD=<secret>
LAB_MAIL_POLL_INTERVAL_SECONDS=120
# method-код письма -> methods.id; сейчас только ГГ (method1) и РП (method3)
LAB_MAIL_METHOD_MAP={"method1":1,"method3":3}
LAB_MAIL_LAB_ID=1

# ekn-service (плагин «Справочник ЕКН»)
EKN_POSTGRES_USER=ekn
EKN_POSTGRES_PASSWORD=<secret>
EKN_POSTGRES_DB=ekn
EKN_OWNER_EMAIL=<owner@tn.ru>
EKN_SERVICE_SECRET=<secret>
# QRC API (PIM, qrc.ai): токен запрашивается на pim@tn.ru, лимит 2 запроса/сек
QRC_API_TOKEN=<secret>
QRC_API_URL=https://qrc.ai

# contacts-service (плагин «Контакты»)
CONTACTS_POSTGRES_USER=contacts
CONTACTS_POSTGRES_PASSWORD=<secret>
CONTACTS_POSTGRES_DB=contacts
CONTACTS_OWNER_EMAIL=<owner@tn.ru>
CONTACTS_SERVICE_SECRET=<secret>

# agent-service (плагин «LogicTEAM.007» — генерация/разбор файлов, S3 sbe-agent)
AGENT_POSTGRES_USER=agent
AGENT_POSTGRES_PASSWORD=<secret>
AGENT_POSTGRES_DB=agent
AGENT_OWNER_EMAIL=<owner@tn.ru>
AGENT_SERVICE_SECRET=<secret>
AGENT_S3_BUCKET=sbe-agent

# S3 (бакет sbe-doc под файлы документов)
S3_ENDPOINT=https://s3.firstvds.ru
S3_ACCESS_KEY=<secret>
S3_SECRET_KEY=<secret>
